[Unit]
Description=Velo sensors (STM32 IMU/GPS/ring line) over Wi-Fi on port 5010
After=network.target
StartLimitIntervalSec=0

[Service]
User=arduino
# Replace ROUTER-SIDE with the non-ttyGS0 address from `ps -eo args | grep [s]ocat`
# (see README_MCU_WIFI.md). One phone/Mac connection at a time.
ExecStart=/usr/bin/socat TCP-LISTEN:5010,reuseaddr ROUTER-SIDE
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
