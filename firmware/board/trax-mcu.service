[Unit]
Description=Trax sensors (STM32 IMU/GPS/ring line) over Wi-Fi on port 5010
After=network.target
StartLimitIntervalSec=0

[Service]
User=arduino
# The STM32's Monitor is on the board's local port 7500 (the USB bridge is
# `socat file:/dev/ttyGS0,... tcp:127.0.0.1:7500`). This relays it to the network.
ExecStart=/usr/bin/socat TCP-LISTEN:5010,reuseaddr,fork TCP:127.0.0.1:7500
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
