[Unit]
Description=Velo front camera
After=network.target
StartLimitIntervalSec=0

[Service]
User=arduino
WorkingDirectory=/home/arduino/velo
ExecStartPre=/bin/sleep 2
ExecStart=/usr/bin/python3 /home/arduino/velo/uno_q_camera.py --camera 0 --port 5000
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
