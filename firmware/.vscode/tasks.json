{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Velo diag: full test + live",
      "type": "shell",
      "command": "python3 hw_diag/hw_diag.py",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true },
      "problemMatcher": []
    },
    {
      "label": "Velo diag: PASS/FAIL table only",
      "type": "shell",
      "command": "python3 hw_diag/hw_diag.py --no-live",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Velo diag: live readings only",
      "type": "shell",
      "command": "python3 hw_diag/hw_diag.py --live",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true },
      "problemMatcher": []
    },
    {
      "label": "Velo diag: recompile + upload sketch",
      "type": "shell",
      "command": "./flash_mcu.sh hw_diag",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
